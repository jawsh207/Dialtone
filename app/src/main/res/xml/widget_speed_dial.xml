<?xml version="1.0" encoding="utf-8"?>
<!-- Speed dial widget (widget/SpeedDialWidget.kt): one cell; the picker opens when it's placed,
     and long-press › reconfigure (Android 12+) picks someone else. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.dialtone.phone.widget.SpeedDialConfigActivity"
    android:description="@string/widget_speed_dial_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
